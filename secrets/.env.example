# EVPulse secrets template — copy to secrets/.env and fill in real values.
# secrets/.env is gitignored (whole secrets/ dir) — never commit it, chmod 600 it.
#
# Deploy with: ./scripts/compose.sh up -d
# (wraps `docker compose --env-file ./secrets/.env` — these values are used both for
#  ${VAR} interpolation in docker-compose.yml at parse time, AND injected at container
#  runtime via each service's `env_file:`. Two different mechanisms, same file.)

# ── Database (PostgreSQL / TimescaleDB) ──────────────────────────────────────
DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=tesla
DB_USER=tesla
DB_PASSWORD=
# Full connection string used by api/api-worker (Prisma). Build from the DB_* values
# above once DB_PASSWORD is set: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?connection_limit=5&pool_timeout=30
# If DB_PASSWORD contains URL-reserved characters (@ : / # ? &), percent-encode it here.
DATABASE_URL=

# ── App ───────────────────────────────────────────────────────────────────
APP_ROLE=
FRONTEND_URL=
BACKEND_URL=
API_PUBLIC_URL=
COOKIE_DOMAIN=

# ── Auth / crypto ─────────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=
ENCRYPTION_MASTER_KEY=
METRICS_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Tesla Fleet API ───────────────────────────────────────────────────────
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_AUDIENCE=
TESLA_AUTH_URL=
TESLA_TOKEN_URL=
TESLA_API_BASE_URL=
TESLA_REDIRECT_URI=
TESLA_ENCRYPTION_KEY=
TESLA_TOKEN_KEY=
TESLA_FLEET_WEBHOOK_SECRET=
TESLA_BUDGET_MONTHLY_EUR=
TESLA_BUDGET_SOFT_PCT=
TESLA_BUDGET_ESTIMATED_EUR_PER_REQUEST=
TESLA_V1_STREAMING_ENABLED=

# ── Fleet Telemetry / vehicle-command proxy ──────────────────────────────
FLEET_INTERNAL_TOKEN=
FLEET_TELEMETRY_CA_B64=
FLEET_TELEMETRY_HOSTNAME=
VEHICLE_COMMAND_PROXY_URL=

# ── Other OEM OAuth (if enabled) ──────────────────────────────────────────
BMW_OAUTH_CLIENT_ID=
BMW_OAUTH_CLIENT_SECRET=
HYUNDAI_OAUTH_CLIENT_ID=
HYUNDAI_OAUTH_CLIENT_SECRET=
VW_CLIENT_ID=
VW_CLIENT_SECRET=

# ── MQTT ──────────────────────────────────────────────────────────────────
MQTT_URL=
MQTT_USER=
MQTT_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── AI (Groq) ─────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Billing (Stripe) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FLEET=

# ── Mail ──────────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# ── Grafana ───────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=

# ── Telegram ops alerts ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=

# ── Trip detection/reconciliation tuning (non-secret, optional overrides) ──
TRIP_PAUSE_SPLIT_CITY_MS=
TRIP_PAUSE_SPLIT_HIGHWAY_MS=
TRIP_PAUSE_SPLIT_RADIUS_KM=
TRIP_RECONCILE_MAX_GAP_MS=
TRIP_RECONCILE_MAX_PROXIMITY_KM=
TRIP_RECONCILE_SHORT_GAP_MS=
TRIP_SESSION_MAX_DIST_KM=
TRIP_SESSION_MAX_GAP_MS=
TRIP_STOPPING_MAX_IDLE_IN_DRIVE_MS=
TRIP_STOP_TIMEOUT_CITY_MS=
TRIP_STOP_TIMEOUT_HIGHWAY_MS=
TELEMETRY_DEDUP_HEARTBEAT_MS=

# ── Firebase (push notifications) ────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=
