{
  "name": "tesla-analytics-platform",
  "version": "1.0.0",
  "description": "Production-grade Tesla vehicle analytics platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/api && npm run lint --workspace=apps/web",
    "type-check": "npm run type-check --workspace=apps/api && npm run type-check --workspace=apps/web",
    "predeploy": "npm run type-check",
    "test": "jest --config jest.config.js --no-coverage",
    "test:watch": "jest --config jest.config.js --watch",
    "deploy": "docker compose run --rm --build api npx prisma migrate deploy --schema=prisma/schema.prisma && docker compose up -d --build api api-worker frontend",
    "predeploy:full": "npm run type-check",
    "deploy:full": "docker compose run --rm --build api npx prisma migrate deploy --schema=prisma/schema.prisma && docker compose up -d --build",
    "logs": "docker compose logs -f api api-worker",
    "restart": "docker compose restart api api-worker"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "keywords": [
    "tesla",
    "analytics",
    "vehicle",
    "tracking",
    "telemetry"
  ],
  "author": "Tesla Analytics",
  "license": "MIT",
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/testing": "^11.1.17",
    "@prisma/client": "5.22.0",
    "@types/jest": "^30.0.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "jest": "^30.3.0",
    "localtunnel": "^2.0.2",
    "ts-jest": "^29.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "minimatch": "^9.0.9",
    "ws": "^8.21.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
